---
import Layout from '~/layouts/PageLayout.astro';

import Content from '~/components/widgets/Content.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Integrations from '~/components/widgets/Integrations.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { Icon } from 'astro-icon/components';
import Headline from '~/components/ui/Headline.astro';
import Timeline from '~/components/ui/Timeline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import { SITE, METADATA, I18N } from 'astrowind:config';
import { profile, mailtoLink } from '~/navigation';
import career from '~/data/career.json';

const metadata = {
  title: SITE?.name,
  ignoreTitleTemplate: true,
};

// Built from `src/config.yaml` and `profile` in `src/navigation.ts`; keep it true for this site.
const personId = `${SITE?.site}/#person`;
const sameAs = [
  profile.github,
  profile.youtube,
  profile.niconico,
  ...(METADATA?.twitter?.handle ? [`https://x.com/${METADATA.twitter.handle.replace(/^@/, '')}`] : []),
];
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': personId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': personId,
    name: profile.name,
    url: SITE?.site,
    sameAs,
  },
];

const visibleExperienceCount = 3;

const escapeHtml = (value: string) =>
  value.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

const formatSkill = (skill: { name: string; level?: string; experienceYears?: number; category?: string }) => {
  const detail = [skill.level, skill.experienceYears != null ? `${skill.experienceYears}年` : undefined, skill.category]
    .filter(Boolean)
    .join(' · ');
  return escapeHtml(detail ? `${skill.name} · ${detail}` : skill.name);
};

const skillIcons: Record<string, string> = {
  Languages: 'tabler:code',
  'Frameworks & Libraries': 'tabler:box',
  Databases: 'tabler:database',
  'OS & Middleware': 'tabler:server',
};

const skillItems = [
  ...career.skillCategories.map((group) => ({
    title: group.category,
    description: group.skills.map((skill) => formatSkill(skill)).join('<br />'),
    icon: skillIcons[group.category] ?? 'tabler:point-filled',
  })),
  {
    title: 'Qualifications',
    description: career.profile.qualifications.map((name) => escapeHtml(name)).join('<br />'),
    icon: 'tabler:certificate',
  },
];

const experienceItems = career.projects.map((project) => {
  const meta = [project.role, project.industry, project.teamSize].filter(Boolean).join(' · ');
  const technologies = Object.values(project.technologies).flat().join(' · ');
  const phases = project.phases.join(' / ');
  const description = [project.description, technologies, phases]
    .filter(Boolean)
    .map((line) => escapeHtml(line))
    .join('<br />');

  return {
    title: `${escapeHtml(project.title)}<br /><span class="font-normal">${escapeHtml(meta)}</span><br /><span class="text-sm font-normal">${escapeHtml(project.period)}</span>`,
    description,
    icon: 'tabler:briefcase',
  };
});

const visibleExperience = experienceItems.slice(0, visibleExperienceCount);
const earlierExperience = experienceItems.slice(visibleExperienceCount);
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <!-- Intro: name beside the profile photo **************** -->

  <Content
    columns={3}
    items={[
      {
        icon: 'tabler:brand-github',
        callToAction: {
          target: '_blank',
          text: 'GitHub',
          href: profile.github,
        },
      },
      {
        icon: 'tabler:brand-x',
        callToAction: {
          target: '_blank',
          text: 'X',
          href: profile.x,
        },
      },
      {
        icon: 'tabler:brand-youtube',
        callToAction: {
          target: '_blank',
          text: 'YouTube',
          href: profile.youtube,
        },
      },
      {
        icon: 'niconico',
        callToAction: {
          target: '_blank',
          text: 'ニコニコ動画',
          href: profile.niconico,
        },
      },
      {
        icon: 'tabler:mail',
        callToAction: {
          text: 'Email',
          href: mailtoLink,
        },
      },
    ]}
    image={{
      src: '~/assets/images/profile.jpg',
      alt: 'Ryuichi Kinjo standing in a forest stream',
      aspect: '3/4',
      loading: 'eager',
    }}
  >
    <Fragment slot="content">
      <p class="mb-1 text-sm font-bold tracking-wide text-secondary uppercase dark:text-blue-200">System Engineer</p>
      <h1 class="mb-4 text-3xl font-bold tracking-tight text-heading sm:text-4xl">{profile.name}</h1>
      <p class="mb-4">
        フリーランスのシステムエンジニアとして、10年以上働いています。要件定義からリリースまで、一貫して担当するのが得意です。
      </p>
      <p class="mb-4">
        Javaを軸に、バックエンドからフロントエンドまで、いろいろな業種で経験してきました。リーダーとして進めることも多いですが、立場にはこだわらず、そのときのプロジェクトに合わせて動きます。
      </p>
      <p class="mb-4">最近は Next.js や Astro、Cursor などの AI ツールを使った開発も、楽しく学んでいます。</p>
      <p>学生時代は野球に打ち込んでいました。趣味は旅行、街ブラ、温泉、料理、ギター、釣り、お酒です。</p>
    </Fragment>
  </Content>

  <!-- Experience *********************** -->

  <WidgetWrapper id="experience" containerClass="max-w-3xl">
    <Headline
      title="Experience"
      classes={{
        container: 'max-w-3xl text-left rtl:text-right',
        title: 'text-3xl lg:text-4xl',
      }}
    />
    <Timeline items={visibleExperience} defaultIcon="tabler:briefcase" />
    {
      earlierExperience.length > 0 && (
        <details class="group mt-2">
          <summary class="flex w-fit cursor-pointer list-none items-center gap-2 py-2 text-sm font-semibold text-primary outline-offset-4 [&::-webkit-details-marker]:hidden">
            <span class="group-open:hidden">以前の職歴を表示（{earlierExperience.length}）</span>
            <span class="hidden group-open:inline">以前の職歴を閉じる</span>
            <Icon name="tabler:chevron-down" class="h-4 w-4 transition-transform duration-200 group-open:rotate-180" />
          </summary>
          <div class="mt-6">
            <Timeline items={earlierExperience} defaultIcon="tabler:briefcase" />
          </div>
        </details>
      )
    }
  </WidgetWrapper>

  <!-- Features3 Widget ************** -->

  <Features3 id="skills" title="Skills" columns={2} items={skillItems} />

  <!-- Integrations Widget *********** -->

  <Integrations
    id="stack"
    title="Tech Stack"
    subtitle="このサイトの制作と公開に使っているツールです。"
    columns={4}
    items={[
      {
        name: 'AstroWind',
        description: 'Site template',
        icon: 'tabler:rocket',
        href: 'https://github.com/arthelokyo/astrowind',
      },
      {
        name: 'Astro',
        description: 'Static site generator',
        icon: 'tabler:brand-astro',
        href: 'https://astro.build',
      },
      {
        name: 'Tailwind CSS',
        description: 'Styling',
        icon: 'tabler:brand-tailwind',
        href: 'https://tailwindcss.com',
      },
      {
        name: 'TypeScript',
        description: 'Language',
        icon: 'tabler:brand-typescript',
        href: 'https://www.typescriptlang.org',
      },
      {
        name: 'pnpm',
        description: 'Package manager',
        icon: 'tabler:package',
        href: 'https://pnpm.io',
      },
      {
        name: 'GitHub',
        description: 'Source control',
        icon: 'tabler:brand-github',
        href: profile.github,
      },
      {
        name: 'GitHub Pages',
        description: 'Staging',
        icon: 'tabler:world',
        href: 'https://ryuichikinjo.github.io/my-portfolio-astrowind-v2/',
      },
      {
        name: 'Vercel',
        description: 'Production',
        icon: 'tabler:brand-vercel',
        href: 'https://rk-playground-v2.vercel.app',
      },
      {
        name: 'Cursor',
        description: 'AI-assisted development',
        icon: 'tabler:code',
        href: 'https://cursor.com',
      },
    ]}
  />
</Layout>
